-- this is a dimension table as it holds customer's descriptive data

-- have to check if the table has any duplicates after joining
-- expected result: null

-- giving user friendly names to the columns
-- arranging the columns in a good manner

-- generating 'SURROGATE KEY' for this table to uniquely identify each record in the table

-- creating a view of the dimension table in the gold layer

create view gold.dim_customers as 
select 
row_number() over (order by ci.cst_id) as customer_key, -- this is a surrogate key
ci.cst_id as customer_id,
ci.cst_key as customer_number,
ci.cst_firstname as firstname,
ci.cst_lastname as lastname,
la.cntry as country,
ci.cst_marital_status as marital_status,

-- since there are two gender data from different tables, integrating them as a single column

case when ci.cst_gndr != 'n/a' then ci.cst_gndr   -- since ca table is the master table prioritising that data
	 else coalesce(ca.gen, 'n/a') 
end as gender,

ca.bdate as birth_date,
ci.cst_create_date as create_date

from silver.crm_cust_info ci

--joining the master table with the other two tables using left join 

left join silver.erp_cust_az12 ca
on ci.cst_key = ca.cid

left join silver.erp_loc_a101 la
on ci.cst_key = la.cid

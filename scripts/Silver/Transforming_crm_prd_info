insert into silver.crm_prd_info (
	prd_id, 
	cat_id,
	prd_key,
	prd_nm,
	prd_cost,
	prd_line,
	prd_start_dt,
	prd_end_dt
)
select
	prd_id,

	replace(substring(prd_key, 1, 5), '-', '_') as cat_id, -- extracting the cat_id from the prd_key
	substring(prd_key, 7, len(prd_key)) as prd_key, -- extracting prd_key from the remaining of the prd_key so that they can be matched with other tables

	prd_nm,

	isnull(prd_cost, 0) as prd_cost, -- this func checks if the cost is null, if then replaces it with zero

	case when upper(trim(prd_line)) = 'M' then 'Mountain' -- normalising the values
		 when upper(trim(prd_line)) = 'R' then 'Roads'
		 when upper(trim(prd_line)) = 'S' then 'Other Sales'
		 when upper(trim(prd_line)) = 'T' then 'Touring'
		 else 'n/a'
	end as prd_line,

	cast(prd_start_dt as date) as prd_start_dt, -- since the time stamp does not give any data, type casting that to date

	-- validating the start_dt and end_dt based on the start_dt
	-- sorts the start_dt for each product key and the end_dt is one day before the next start_dt entry

	cast(lead(prd_start_dt) over (partition by prd_key order by prd_start_dt)-1 as date) as prd_end_dt
	
from bronze.crm_prd_info;

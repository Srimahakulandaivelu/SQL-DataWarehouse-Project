-- analysing and transforming the crm_cust_info table

-- check for duplicates
-- expectation result: no result

select cst_id ,
count(*)
from silver.crm_cust_info
group by cst_id
having count(*) > 1; 

-- check for trailing spaces in the strings
-- expected result : 0

select count(cst_firstname) 
from silver.crm_cust_info
where cst_firstname != trim(cst_firstname);

-- Data standardization and Consistency (giving full names instead of depictions)
-- eg : F as female and M as Male in gender

select distinct(cst_gndr)
from silver.crm_cust_info;

select * from silver.crm_cust_info;

-- the above code is to validate the cleaning and transformation process

 -- removes the duplicate entries by using a window function 
-- it partitions the rows based on cst_id and ranks those based on recently created entry
-- from the ranking only take flag_last = 1, by doing this only unique entries are preserved

insert into silver.crm_cust_info (cst_id,   -- inserting into the silver layer table
cst_key, 
cst_firstname, 
cst_lastname, 
cst_marital_status, 
cst_gndr, 
cst_create_date)

select 
cst_id,
cst_key,
trim(cst_firstname) as cst_firstname,   -- trims the trailing spaces from the first and last names
trim(cst_lastname) as cst_lastname,

case when upper(trim(cst_marital_status)) = 'M' then 'Married'
	 when upper(trim(cst_marital_status)) = 'S' then 'Single'
	 else 'n/a'
end cst_marital_status,

case when upper(trim(cst_gndr)) = 'F' then 'Female'  -- normalize the values of the table
	 when upper(trim(cst_gndr)) = 'M' then 'Male'
	 else 'n/a'
end cst_gndr,

cst_create_date

from(
	select *,
	row_number() over (partition by cst_id order by cst_create_date desc) as flag_last
	from bronze.crm_cust_info
	where cst_id is not null
)t where flag_last = 1;

